	-1,
	0,
	0};
#endif  /* !defined(ASN_DISABLE_JER_SUPPORT) */

/*** <<< STAT-DEFS [Bits] >>> ***/

static const asn_OCTET_STRING_specifics_t asn_SPC_Bits_specs_1 = {
	sizeof(BIT_STRING_t),
	offsetof(BIT_STRING_t, _asn_ctx),
	ASN_OSUBV_BIT,
	1	/* Has NamedBitList: trailing 0 bits are insignificant */
};
static const ber_tlv_tag_t asn_DEF_Bits_tags_1[] = {
	(ASN_TAG_CLASS_UNIVERSAL | (3 << 2))
};

/* Custom XER encoder per ENCODING-CONTROL directive */
static asn_enc_rval_t
Bits_encode_xer(const asn_TYPE_descriptor_t *td, const void *sptr,
	int ilevel, enum xer_encoder_flags_e flags,
	asn_app_consume_bytes_f *cb, void *app_key) {
	const BIT_STRING_t *st = (const BIT_STRING_t *)sptr;
	asn_enc_rval_t er = {0, 0, 0};
	int first = 1;
	(void)td;
	(void)ilevel;
	(void)flags;
	if(!st || !st->buf) ASN__ENCODE_FAILED;
	if(st->size > 0 && (st->buf[0] & 0x80)) {
		if(!first) ASN__CALLBACK(" ", 1);
		ASN__CALLBACK("alpha", 5);
		er.encoded += 5 + (first ? 0 : 1);
		first = 0;
	}
	if(st->size > 0 && (st->buf[0] & 0x40)) {
		if(!first) ASN__CALLBACK(" ", 1);
		ASN__CALLBACK("beta", 4);
		er.encoded += 4 + (first ? 0 : 1);
		first = 0;
	}
	ASN__ENCODED_OK(er);
	cb_failed:
		ASN__ENCODE_FAILED;
}


/* Custom XER decoder per ENCODING-CONTROL directive */
static enum xer_pbd_rval
Bits_xer_text_body_decode(const asn_TYPE_descriptor_t *td,
	void *sptr, const void *chunk_buf, size_t chunk_size) {
	BIT_STRING_t *st = (BIT_STRING_t *)sptr;
	const char *p = (const char *)chunk_buf;
	const char *end = p + chunk_size;
	size_t max_bit = 0;
	int any = 0;
	(void)td;
	if(max_bit < 0) max_bit = 0;
	if(max_bit < 1) max_bit = 1;
	if(OCTET_STRING_fromBuf((OCTET_STRING_t *)st, 0,
		(int)((max_bit / 8) + 1))) return XPBD_SYSTEM_FAILURE;
	memset(st->buf, 0, st->size);
	st->bits_unused = (int)((8 - ((max_bit + 1) % 8)) % 8);
	while(p < end) {
		const char *start;
		int matched = 0;
		while(p < end && (*p == 9 || *p == 10 || *p == 13 || *p == 32)) p++;
		if(p == end) break;
		start = p;
		while(p < end && *p != 9 && *p != 10 && *p != 13 && *p != 32) p++;
		if(!matched && (size_t)(p - start) == 5
			&& memcmp(start, "alpha", 5) == 0) {
			st->buf[0] |= 0x80;
			matched = 1;
		}
		if(!matched && (size_t)(p - start) == 4
			&& memcmp(start, "beta", 4) == 0) {
			st->buf[0] |= 0x40;
			matched = 1;
		}
		if(!matched) return XPBD_BROKEN_ENCODING;
		any = 1;
	}
	return any ? XPBD_BODY_CONSUMED : XPBD_NOT_BODY_IGNORE;
}

static asn_dec_rval_t
Bits_decode_xer(const asn_codec_ctx_t *opt_codec_ctx,
	const asn_TYPE_descriptor_t *td, void **sptr,
	const char *opt_mname, const void *buf_ptr, size_t size) {
	return xer_decode_primitive(opt_codec_ctx, td,
		sptr, sizeof(BIT_STRING_t), opt_mname,
		buf_ptr, size, Bits_xer_text_body_decode);
}

