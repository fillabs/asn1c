		content EXT-TYPE.&ExtContent({ExtensionTypes}{@.id})
	}

	MyExtensions EXT-TYPE ::= { {BOOLEAN IDENTIFIED BY 1}, ... }

	MyExtension ::= Extension{{MyExtensions}}

END
